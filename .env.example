# ---- Compose ---------------------------------------------------------------
# "mock" starts the fake Google / WhatsApp / Groq server. Leave empty in production.
COMPOSE_PROFILES=mock
TZ=Asia/Kolkata

# ---- Postgres --------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
TORI_DB_PASSWORD=change-me-tori
N8N_DB_PASSWORD=change-me-n8n

# ---- n8n -------------------------------------------------------------------
N8N_ENCRYPTION_KEY=change-me-to-32-random-chars-000
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
# Owner account created automatically on first start
N8N_OWNER_EMAIL=ops@toridesk.com
N8N_OWNER_PASSWORD=ChangeMe123!
N8N_OWNER_FIRST_NAME=Tori
N8N_OWNER_LAST_NAME=Ops

# Basic auth the inbound provider (Postmark) uses on the webhook URL
INBOUND_WEBHOOK_USER=postmark
INBOUND_WEBHOOK_PASSWORD=change-me-inbound
# Header X-Tori-Admin-Key for the /webhook/admin/* endpoints
ADMIN_API_KEY=change-me-admin

# ---- LLM email parser (Groq, OpenAI-compatible API) -------------------------
# Mock: http://mock-apis:8090/groq/openai/v1   Real: https://api.groq.com/openai/v1
LLM_BASE_URL=http://mock-apis:8090/groq/openai/v1
LLM_API_KEY=gsk_your_groq_key
LLM_MODEL=openai/gpt-oss-120b

# ---- Google Calendar -------------------------------------------------------
GOOGLE_TOKEN_URI=http://mock-apis:8090/google/token
GCAL_BASE_URL=http://mock-apis:8090/google/calendar/v3
# base64 of the service account JSON key (tori-calendar@tori-desk.iam.gserviceaccount.com).
# Empty = a throwaway key is generated for the mock.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

# ---- WhatsApp (Meta Cloud API) ---------------------------------------------
WHATSAPP_BASE_URL=http://mock-apis:8090/whatsapp/v21.0
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_TOKEN=mock-token
# text = free-form messages (only valid inside Meta's 24h window, fine for mock/dev)
# template = approved templates tori_<event> (production)
WHATSAPP_MODE=text
WHATSAPP_TEMPLATE_LANG=en
