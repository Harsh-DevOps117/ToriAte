COMPOSE_PROFILES=mock
TZ=Asia/Kolkata

POSTGRES_PASSWORD=change-me-postgres
TORI_DB_PASSWORD=change-me-tori
N8N_DB_PASSWORD=change-me-n8n

N8N_ENCRYPTION_KEY=change-me-to-32-random-chars-000
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
N8N_OWNER_EMAIL=ops@toridesk.com
N8N_OWNER_PASSWORD=ChangeMe123!
N8N_OWNER_FIRST_NAME=Tori
N8N_OWNER_LAST_NAME=Ops

INBOUND_WEBHOOK_USER=postmark
INBOUND_WEBHOOK_PASSWORD=change-me-inbound
ADMIN_API_KEY=change-me-admin

LLM_BASE_URL=http://mock-apis:8090/groq/openai/v1
LLM_API_KEY=gsk_your_groq_key
LLM_MODEL=openai/gpt-oss-120b

GOOGLE_TOKEN_URI=http://mock-apis:8090/google/token
GCAL_BASE_URL=http://mock-apis:8090/google/calendar/v3
GOOGLE_SERVICE_ACCOUNT_JSON_B64=

WHATSAPP_BASE_URL=http://mock-apis:8090/whatsapp/v21.0
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_TOKEN=mock-token
WHATSAPP_MODE=text
WHATSAPP_TEMPLATE_LANG=en

# ── Workflow 06: the WhatsApp bot with partner matching (optional) ─────────────
# Meta → your app → WhatsApp → API Setup: the bot number's phone number ID and an access token.
BOT_WHATSAPP_PHONE_NUMBER_ID=
BOT_WHATSAPP_TOKEN=
# Meta → your app → App settings → Basic: App ID and App secret (for the WhatsApp Trigger).
BOT_META_APP_ID=
BOT_META_APP_SECRET=
# 1 = publish workflow 06. This points the Meta app's webhook at THIS n8n (scripts/bot-tunnel.sh).
BOT_ENABLED=0
# Database for the bot. Empty = this repo's Postgres (db `tori`). For Supabase use its connection details.
BOT_PG_HOST=
BOT_PG_PORT=
BOT_PG_DATABASE=
BOT_PG_USER=
BOT_PG_PASSWORD=
BOT_PG_SSL=
# Only needed for the bot's older booking / cab-share paths, which use Supabase directly.
BOT_SUPABASE_URL=
BOT_SUPABASE_SERVICE_KEY=
# Graph API base for the bot's sends. Empty = https://graph.facebook.com/v19.0 (tests point it at mock-apis).
BOT_WHATSAPP_GRAPH_URL=

# ── Travel partner matching (workflows 07–12) ──────────────────────────────────────
# Empty = the default shown (defaults live in public.travel_cfg(), db/migrations/005_travel_functions.repeatable.sql).
TRAVEL_MAX_SOURCE_DISTANCE_KM=           # 3     start points at most this far apart
TRAVEL_MAX_DESTINATION_DISTANCE_KM=      # 5     destinations at most this far apart
TRAVEL_MAX_TIME_DIFFERENCE_MINUTES=      # 45    departure times at most this far apart (same day)
TRAVEL_MAX_MATCH_CANDIDATES=             # 3     ranked candidates kept per request; shown one at a time
TRAVEL_SCORE_WEIGHT_SOURCE=              # 0.4   ranking weights (travel_match_score)
TRAVEL_SCORE_WEIGHT_DESTINATION=         # 0.4
TRAVEL_SCORE_WEIGHT_TIME=                # 0.2
TRAVEL_CONSENT_TIMEOUT_MINUTES=          # 120   time to answer "Would you like to connect?"
TRAVEL_INTENT_GRACE_MINUTES=             # 30    a request expires this long after its departure time
TRAVEL_DRAFT_TTL_MINUTES=                # 180   an unfinished request is forgotten after this
TRAVEL_MAX_DAYS_AHEAD=                   # 30
TRAVEL_MAX_REQUEST_CHANGES_PER_HOUR=     # 5     new or changed requests per user (anti-enumeration)
TRAVEL_MAX_REQUEST_CHANGES_PER_DAY=      # 15
TRAVEL_DECLINE_COOLDOWN_DAYS=            # 7     two people who said no are not paired again for this long
TRAVEL_GEOCODE_CACHE_DAYS=               # 90
TRAVEL_GEOCODE_AMBIGUITY_KM=             # 25    top results further apart than this = "which city?"
# Geocoder: nominatim (default; OpenStreetMap, no key, 1 request/second, needs an identifying
# User-Agent; for production volume self-host it or use a commercial Nominatim-compatible API) or google.
TRAVEL_GEOCODER=nominatim
TRAVEL_GEOCODER_URL=                     # empty = the provider's public endpoint
TRAVEL_GEOCODER_KEY=                     # google only
TRAVEL_GEOCODER_COUNTRY=in
TRAVEL_GEOCODER_USER_AGENT='ToriWhatsAppBot/1.0 (ops@toridesk.com)'
# Approved WhatsApp template (Utility, quick replies "Yes, connect" / "No thanks") for match
# requests to people outside the 24-hour window. Empty = those requests are skipped and logged.
TRAVEL_MATCH_TEMPLATE=
TRAVEL_TEMPLATE_LANG=en
# Trip form (WhatsApp Flow with a date picker and time list), sent when a travel request is missing
# details or "🚕 Cab buddy" is picked from the menu. Empty = the bot asks in chat instead.
# scripts/create-travel-flow.sh creates it in Meta and fills these two in (it needs BOT_WABA_ID).
BOT_WABA_ID=                             # Meta → app → WhatsApp → API Setup → WhatsApp Business Account ID
TRAVEL_TRIP_FLOW_ID=
TRAVEL_TRIP_FLOW_MODE=                   # draft (unpublished, for testing) or published

# ── Google (optional): workflow 06 hands Google requests to the ToriGoogle stack (../ToriGoogle) ──
# Its n8n joins this stack's network (ToriGoogle docker-compose.whatsapp.yml). Empty = off.
TORI_GOOGLE_URL=
# = N8N_WEBHOOK_SECRET in ToriGoogle's .env
TORI_GOOGLE_SECRET=

# ── Partner board (web/, http://localhost:3001): every partner request, live, with filters ─────────
# The bot's WhatsApp number (digits, with country code) for the "I'm in" / "Post a request" buttons.
# Empty = the board only lists requests.
BOARD_WHATSAPP_NUMBER=
BOARD_PORT=3001

# Approved WhatsApp template for match offers to people outside the 24-hour window (4 body params:
# sport, name, when, area; quick replies Yes / No). Empty = keep the offer and send it when they next write.
PARTNER_MATCH_TEMPLATE=

# Voice notes ("about you") are transcribed by Whisper. Empty = Groq whisper-large-v3-turbo with LLM_API_KEY.
TRANSCRIBE_BASE_URL=
TRANSCRIBE_MODEL=
# Where transcribed voice notes are posted back as text. Empty = this n8n's WhatsApp Trigger.
BOT_RELAY_URL=

# ── Tori Wallet (web/ /wallet + workflow 06): prepaid credits, Razorpay top-ups, one-tap checkout ────
# Razorpay → Settings → API keys (test mode while developing). The secret stays in the web container.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay → Settings → Webhooks: URL https://<board>/api/razorpay/webhook, events payment.captured,
# order.paid, payment.failed, and this secret
RAZORPAY_WEBHOOK_SECRET=
# shared by the web app and n8n for /webhook/wallet/charge and /webhook/wallet/notify (any long random string)
WALLET_API_KEY=
# 1 = "test booking 300" on WhatsApp makes a demo payment request (for trying one-tap checkout)
WALLET_DEMO=0

# ── ToriPay ("tori pay gym 500"): pay verified gyms, turfs and coaches from the wallet ──────────────────
# RazorpayX → Account details: the account number payouts are sent from. Empty = payments stay owed to
# each business in the ledger; the team pays them by bank transfer (GET /api/admin/payees/owed, then
# POST /api/admin/payees/settle).
RAZORPAYX_ACCOUNT_NUMBER=
# RazorpayX → Settings → Webhooks: URL https://<board>/api/razorpayx/webhook, events payout.processed,
# payout.failed, payout.reversed, payout.rejected. Empty = RAZORPAY_WEBHOOK_SECRET.
RAZORPAYX_WEBHOOK_SECRET=
# the Tori team's key for adding businesses (POST /api/admin/payees, header x-tori-admin). Never share it.
TORI_ADMIN_KEY=

# ── Harsh AI voice assistant (docs/VOICE.md): the /voice web page + WhatsApp calls → Vapi ─────────────
# Vapi dashboard → API Keys. The PUBLIC key goes to browsers: restrict it there to your site's origins
# and to this assistant. The PRIVATE key stays server-side (voice-bridge only); never put it in NEXT_PUBLIC_*.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_PRIVATE_API_KEY=
VAPI_ASSISTANT_ID=afd96ebf-40a7-40d2-bc0b-b6b94367e588
# WhatsApp calls use the bot's Meta app and number: BOT_WHATSAPP_TOKEN, BOT_WHATSAPP_PHONE_NUMBER_ID,
# BOT_META_APP_SECRET above (META_ACCESS_TOKEN / META_PHONE_NUMBER_ID / META_APP_SECRET work as aliases).
# Shared by n8n and voice-bridge: n8n sends it on every call webhook, the bridge on every lifecycle event
# (any long random string: openssl rand -hex 32)
VOICE_BRIDGE_SECRET=
# Vapi → n8n (/webhook/vapi/events: tool calls, end-of-call reports) must send header x-vapi-secret with
# this value. Set the same header on the assistant's Server URL in the Vapi dashboard.
VAPI_SERVER_SECRET=
# Optional: point WhatsApp calls' Vapi server messages here instead of the dashboard's Server URL
# (e.g. https://<n8n public address>/webhook/vapi/events). Empty = keep the assistant's own setting.
VAPI_SERVER_URL=
# Only when a Meta app sends call webhooks straight to the bridge (GET/POST /meta/webhook) instead of n8n
META_VERIFY_TOKEN=
# Calls handled at once (more are rejected as busy), and the longest call in seconds
VOICE_MAX_CALLS=5
VOICE_MAX_CALL_SECONDS=900
# STUN for the bridge's public address (comma-separated). Empty = stun:stun.l.google.com:19302
VOICE_STUN_URLS=
VOICE_LOG_LEVEL=info
# Tori MCP server (web /api/mcp): gives the voice agent Tori's tools (open games, status, find a partner or cab
# buddy, join, wallet link, invite). Any long random string (openssl rand -hex 32); scripts/vapi-mcp.sh puts it
# on the assistant's MCP tool. Empty = the MCP server refuses every request.
TORI_MCP_KEY=
