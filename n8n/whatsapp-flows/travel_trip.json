    {
      "id": "TRIP",
      "title": "Find a cab buddy",
      "terminal": true,
      "success": true,
      "data": {
        "source": {
          "type": "string",
          "__example__": "Jhunsi, Prayagraj"
        },
        "destination": {
          "type": "string",
          "__example__": "Civil Lines, Prayagraj"
        },
        "min_date": {
          "type": "string",
          "__example__": "2026-10-04"
        },
        "max_date": {
          "type": "string",
          "__example__": "2026-11-03"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextSubheading",
            "text": "Where and when are you going?"
          },
          {
            "type": "TextBody",
            "text": "We'll look for someone travelling a similar route. Your number and exact places stay private unless you both agree to connect."
          },
          {
            "type": "TextInput",
            "name": "source",
            "label": "From (area, city)",
            "input-type": "text",
            "required": true,
            "init-value": "${data.source}",
            "helper-text": "e.g. Jhunsi, Prayagraj"
          },
          {
            "type": "TextInput",
