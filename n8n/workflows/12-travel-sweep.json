        "mode": "runOnceForAllItems",
        "jsCode": "// notifications decided by the database; workflow 11 renders and sends them\nreturn $('Expire trips and matches').all().flatMap((i) => i.json.r.notifications || []).map((n) => ({ json: n }));\n"
      },
      "id": "6cf986b6-9f98-57b5-9f80-7e489fd7e1a8",
