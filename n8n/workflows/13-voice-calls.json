{
  "id": "toriVoiceCalls01",
  "name": "Tori 13 · Voice calls (WhatsApp → Harsh AI)",
  "description": "Control plane for Harsh AI voice calls: forwards WhatsApp call webhooks (from 06) to voice-bridge, logs the call lifecycle, answers Vapi tool calls and stores end-of-call reports. Audio never passes through n8n.",
  "nodes": [
    {
      "parameters": {
        "inputSource": "passthrough"
      },
      "id": "dd00d067-22b6-58ca-8c2f-daa72d7968c5",
