        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.VOICE_BRIDGE_URL || 'http://voice-bridge:8099') + '/calls/event' }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-bridge-secret",
              "value": "={{ $env.VOICE_BRIDGE_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "f8ea1539-fa06-53c6-b74c-84132d3fc004",
      "name": "Forward to voice bridge",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// value.calls[] (+ the caller in value.contacts[0]) → one item per call event, with what the bridge did\nconst out = [];\nconst hooks = $('Call webhook from 06').all();\n$input.all().forEach((res, i) => {\n  const v = hooks[i]?.json || {};\n  const handled = res.json.body?.handled || [];\n  const contact = (v.contacts || [])[0] || {};\n  for (const c of v.calls || []) {\n    out.push({ json: { ev: {\n      ...c,\n      wa_id: c.from || c.from_user_id || contact.wa_id || contact.user_id || null,\n      name: contact.profile?.name || null,\n      errors: v.errors || c.errors,\n      bridge: handled.find((h) => h.id === c.id)?.result || (res.json.statusCode ? `http_${res.json.statusCode}` : 'unreachable'),\n    } } });\n  }\n});\nreturn out;\n"
      },
      "id": "93ae80df-5336-5d75-8bed-3b6fb101a39a",
      "name": "One row per call event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {
